# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

**/.idea
/mongo
**/rabbitmq

# Git worktrees
.worktrees/
# golangci-lint custom plugin binary (built locally)
/custom-gcl

# Generated protobuf Go stubs — produced by `make proto` / Docker build.
# OpenAPI (docs/v1/openapi.yaml) is intentionally committed: it is the REST
# contract the frontend consumes and is reviewed on every proto change.
/gen/
